{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node"]
  },
  "include": [
    "faust_doc_tools.ts",
    "faust_browser_mcp.ts",
    "faust_browser_runtime.mjs",
    "faust_dsp_utils.mjs",
    "metrics_utils.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "ui/node_modules"
  ]
}
